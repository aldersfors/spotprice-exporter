{
  "release-type": "simple",
  "include-v-in-tag": true,
  "changelog-path": "CHANGELOG.md",
  "changelog-type": "github",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-title-pattern": "chore(release): ${version}",
  "pull-request-header": "## spotprice-exporter release\n\nThis PR bumps the crate, the Helm chart version and appVersion, and the default image tag in values.yaml.",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        },
        {
          "type": "generic",
          "path": "Cargo.lock"
        },
        {
          "type": "yaml",
          "path": "charts/spotprice-exporter/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/spotprice-exporter/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "yaml",
          "path": "charts/spotprice-exporter/values.yaml",
          "jsonpath": "$.image.tag"
        }
      ]
    }
  }
}
